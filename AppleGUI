        bl.FillDirection = Enum.FillDirection.Vertical
        bl.HorizontalAlignment = Enum.HorizontalAlignment.Center
        bl.VerticalAlignment = Enum.VerticalAlignment.Bottom
        bl.Padding = UDim.new(0, 6)

        local function dismiss(callback)
            tween(card, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1})
            local st = tween(cardScale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.96})
            st.Completed:Wait()
            activeModal = nil
            overlay:Destroy()
            if callback then task.spawn(callback) end
        end

        for index, spec in ipairs(buttonsSpec) do
            local b = Instance.new("TextButton")
            b.Parent = buttonHolder
            b.Size = UDim2.new(1, 0, 0, 44)
            b.BackgroundColor3 = index == 1 and BLUE or Color3.fromRGB(238, 238, 242)
            b.BackgroundTransparency = index == 1 and 0 or 0.1
            b.BorderSizePixel = 0
            b.Text = spec.text or "OK"
            b.TextColor3 = index == 1 and Color3.new(1, 1, 1) or TEXT
            b.Font = Enum.Font.GothamMedium
            b.TextSize = 16
            b.AutoButtonColor = false
            b.ZIndex = 83
            corner(b, 11)
            addPressAnimation(b, 0.97)
            b.Activated:Connect(function()
                task.spawn(dismiss, spec.callback)
