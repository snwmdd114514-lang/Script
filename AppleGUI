        if currentMobile then
            -- iPhone/iPad compact presentation: wider margins, shorter chrome,
            -- and a content-first proportion instead of stretching edge-to-edge.
            local width = math.max(320, math.min(v.X - 16, 720))
            local height = math.max(440, math.min(v.Y - 64, 610))

            main.Size = UDim2.fromOffset(width, height)
