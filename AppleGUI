    ------------------------------------------------------------------------
    -- Search filtering (event driven; no RenderStep loop)
    ------------------------------------------------------------------------

    local function updateSearch()
        local query = string.upper(searchtextbox.Text or "")
        for _, item in ipairs(sections) do
            local button = item.button
            if query == "" then
                button.Visible = true
            else
                button.Visible = string.find(string.upper(button.Text), query, 1, true) ~= nil
            end
        end
    end

    searchtextbox:GetPropertyChangedSignal("Text"):Connect(updateSearch)

