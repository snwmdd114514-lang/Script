        local t2 = Instance.new("TextLabel")
        t2.Parent = toast
        t2.Position = UDim2.fromOffset(70, 35)
        t2.Size = UDim2.new(1, -82, 0, 28)
        t2.BackgroundTransparency = 1
        t2.Text = text2 or ""
