        t2.TextSize = 13
        t2.TextWrapped = true
        t2.TextXAlignment = Enum.TextXAlignment.Left
        t2.TextYAlignment = Enum.TextYAlignment.Top
        t2.ZIndex = 501

        tween(toast, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(1, -12, 0, 62 + ((toastCount - 1) * 86)),
            GroupTransparency = 0,
        })
        tween(toastScale, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})

        task.delay(4.0, function()
            if not toast.Parent then return end
            tween(toast, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(1, 30, toast.Position.Y.Scale, toast.Position.Y.Offset),
