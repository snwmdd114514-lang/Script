    ------------------------------------------------------------------------
    -- Window animation
    ------------------------------------------------------------------------

    local visible = not isMobileLayout()
    local animating = false

    local function showWindow(immediate)
        if animating or main.Visible then return end
        animating = true
        main.Visible = true

        if immediate then
            main.Position = UDim2.new(0.5, 0, 0.5, 0)
            main.GroupTransparency = 0
            mainScale.Scale = currentMobile and 1 or mainScale.Scale
            animating = false
            return
        end

        local targetScale = mainScale.Scale
        main.Position = UDim2.new(0.5, 0, 0.5, 18)
        main.GroupTransparency = 0.18
        mainScale.Scale = targetScale * 0.95

        tween(main, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, 0, 0.5, 0),
            GroupTransparency = 0,
        })
        local scaleTween = tween(mainScale, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Scale = targetScale,
        })
        scaleTween.Completed:Wait()
        animating = false
    end

    local function hideWindow()
        if animating or not main.Visible then return end
        animating = true

        local targetScale = mainScale.Scale
        tween(main, TweenInfo.new(0.20, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, 0, 0.5, 14),
            GroupTransparency = 0.16,
        })
        local scaleTween = tween(mainScale, TweenInfo.new(0.20, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Scale = targetScale * 0.965,
        })
        scaleTween.Completed:Wait()

        main.Visible = false
        main.GroupTransparency = 0
        main.Position = UDim2.new(0.5, 0, 0.5, 0)
        mainScale.Scale = targetScale
        animating = false
    end

    local window = {}

    function window:ToggleVisible()
        visible = not main.Visible
        if visible then
            showWindow(false)
        else
            hideWindow()
        end
    end

    function window:Show()
        visible = true
        showWindow(false)
    end

    function window:Hide()
        visible = false
        hideWindow()
    end

    function window:GetFPS()
        return fps
    end

    islandHit.Activated:Connect(function()
        task.spawn(playIslandJelly)
        -- Mobile behavior: one tap on the island directly opens the full UI.
        -- No intermediate island expansion state.
        if not main.Visible then
            visible = true
            task.spawn(showWindow, false)
        end
    end)

    minimize.Activated:Connect(function()
        visible = false
        task.spawn(hideWindow)
    end)

    close.Activated:Connect(function()
        if fpsConnection then
            fpsConnection:Disconnect()
        end
        scrgui:Destroy()
    end)

    if visiblekey then
        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == visiblekey then
                window:ToggleVisible()
            end
        end)
    end

    function window:GreenButton(callback)
        if window._greenConnection then
            window._greenConnection:Disconnect()
        end
        window._greenConnection = resize.Activated:Connect(function()
            if callback then callback() end
        end)
    end

    ------------------------------------------------------------------------
    -- Dragging, isolated to the top bar center
    ------------------------------------------------------------------------

    local dragging = false
    local dragInput
    local dragStart
    local startPos

    dragRegion.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragRegion.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and main.Visible then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    ------------------------------------------------------------------------
    -- Splash
