local function getGuiParent()
    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then
            return hui
        end
    end
    return CoreGui
end

local function safeProtect(gui)
    if syn and typeof(syn.protect_gui) == "function" then
        pcall(function()
            syn.protect_gui(gui)
        end)
    end
end

local function addPressAnimation(button, scaleAmount)
    scaleAmount = scaleAmount or 0.975

    local uiScale = Instance.new("UIScale")
    uiScale.Scale = 1
    uiScale.Parent = button

    local downTween
    local upTween

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if downTween then downTween:Cancel() end
            downTween = tween(
                uiScale,
                TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Scale = scaleAmount}
            )
        end
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if upTween then upTween:Cancel() end
            upTween = tween(
                uiScale,
                TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {Scale = 1}
            )
        end
    end)
end

local function createTrafficButton(parent, color, kind, order)
    -- macOS traffic lights are visually small; the hit region remains much
    -- larger than the colored dot so touch users can still hit them reliably.
    local hit = Instance.new("TextButton")
    hit.Name = kind == "close" and "close" or (kind == "minimize" and "minimize" or "resize")
    hit.Parent = parent
    hit.Size = UDim2.fromOffset(18, 18)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.LayoutOrder = order
    hit.ZIndex = 12

    local dot = Instance.new("Frame")
    dot.Name = "Dot"
    dot.Parent = hit
    dot.AnchorPoint = Vector2.new(0.5, 0.5)
    dot.Position = UDim2.fromScale(0.5, 0.5)
    dot.Size = UDim2.fromOffset(13, 13)
    dot.BackgroundColor3 = color
    dot.BorderSizePixel = 0
    dot.ZIndex = 13
    circle(dot)

    local glyph = Instance.new("Frame")
    glyph.Name = "Glyph"
    glyph.Parent = dot
    glyph.AnchorPoint = Vector2.new(0.5, 0.5)
    glyph.Position = UDim2.fromScale(0.5, 0.5)
    glyph.Size = UDim2.fromOffset(8, 8)
    glyph.BackgroundTransparency = 1
    glyph.ZIndex = 14

    local glyphColor
    if kind == "close" then
        glyphColor = Color3.fromRGB(93, 28, 24)
        for _, rotation in ipairs({45, -45}) do
            local bar = Instance.new("Frame")
            bar.Parent = glyph
            bar.AnchorPoint = Vector2.new(0.5, 0.5)
            bar.Position = UDim2.fromScale(0.5, 0.5)
            bar.Size = UDim2.fromOffset(6, 1)
            bar.Rotation = rotation
            bar.BackgroundColor3 = glyphColor
            bar.BackgroundTransparency = 1
            bar.BorderSizePixel = 0
            bar.ZIndex = 15
            corner(bar, 1)
        end
    elseif kind == "minimize" then
        glyphColor = Color3.fromRGB(104, 69, 17)
        local bar = Instance.new("Frame")
        bar.Parent = glyph
        bar.AnchorPoint = Vector2.new(0.5, 0.5)
        bar.Position = UDim2.fromScale(0.5, 0.5)
        bar.Size = UDim2.fromOffset(6, 1)
        bar.BackgroundColor3 = glyphColor
        bar.BackgroundTransparency = 1
        bar.BorderSizePixel = 0
        bar.ZIndex = 15
        corner(bar, 1)
    else
        glyphColor = Color3.fromRGB(21, 85, 31)
        -- Opposing corner marks approximate the modern macOS full-screen glyph
        -- more faithfully than a literal plus sign.
        local pieces = {
            {pos = UDim2.fromOffset(4, 1), size = UDim2.fromOffset(3, 1)},
            {pos = UDim2.fromOffset(6, 1), size = UDim2.fromOffset(1, 3)},
            {pos = UDim2.fromOffset(1, 6), size = UDim2.fromOffset(3, 1)},
            {pos = UDim2.fromOffset(1, 4), size = UDim2.fromOffset(1, 3)},
        }
        for _, piece in ipairs(pieces) do
            local bar = Instance.new("Frame")
            bar.Parent = glyph
            bar.Position = piece.pos
            bar.Size = piece.size
            bar.BackgroundColor3 = glyphColor
            bar.BackgroundTransparency = 1
            bar.BorderSizePixel = 0
            bar.ZIndex = 15
            corner(bar, 1)
        end
    end

    local function setGlyph(alpha)
        for _, child in ipairs(glyph:GetChildren()) do
            if child:IsA("Frame") then
                tween(child, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundTransparency = alpha
                })
            end
        end
    end

    hit.MouseEnter:Connect(function() setGlyph(0.05) end)
    hit.MouseLeave:Connect(function() setGlyph(1) end)
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            setGlyph(0.05)
        end
    end)
    hit.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            task.delay(0.12, function() setGlyph(1) end)
        end
    end)

    addPressAnimation(hit, 0.94)
    return hit
end

