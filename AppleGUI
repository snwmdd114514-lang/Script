        end

        activeModal = overlay
        tween(card, TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0})
        tween(cardScale, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
