                if mobile then
                    label.Position = UDim2.fromOffset(14, 4)
                    label.Size = UDim2.new(1, -28, 0, 32)
                    field.Position = UDim2.new(0, 12, 0, 40)
                    field.Size = UDim2.new(1, -24, 0, 42)
                else
                    label.Position = UDim2.fromOffset(14, 0)
                    label.Size = UDim2.new(0.40, -8, 1, 0)
                    field.Position = UDim2.new(0.40, 0, 0.5, -19)
                    field.Size = UDim2.new(0.60, -12, 0, 38)
                end
            end
            table.insert(responsiveCallbacks, applyTextFieldLayout)
            applyTextFieldLayout(currentMobile)

            local textBox = Instance.new("TextBox")
            textBox.Parent = field
            textBox.BackgroundTransparency = 1
            textBox.Position = UDim2.fromOffset(12, 0)
            textBox.Size = UDim2.new(1, -24, 1, 0)
            textBox.ClearTextOnFocus = false
            textBox.Font = Enum.Font.Gotham
            textBox.PlaceholderColor3 = TERTIARY
            textBox.PlaceholderText = placeholder or "Type…"
            textBox.Text = ""
            textBox.TextColor3 = TEXT
            textBox.TextSize = 15
            textBox.TextXAlignment = Enum.TextXAlignment.Left
            textBox.ZIndex = 18

            textBox.Focused:Connect(function()
                tween(field, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = Color3.fromRGB(248, 248, 250),
                    BackgroundTransparency = 0,
                })
                tween(fieldStroke, TweenInfo.new(0.16), {Transparency = 0.48})
            end)

            textBox.FocusLost:Connect(function()
                tween(field, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = SOFT,
                    BackgroundTransparency = 0.04,
                })
                tween(fieldStroke, TweenInfo.new(0.16), {Transparency = 1})
                if callback then callback(textBox.Text) end
            end)

            return row
        end

        sidebar2.Activated:Connect(function()
            sec:Select()
        end)

        applyLayout()

        if #sections == 1 then
            sec:Select()
        end

        return sec
    end

    ------------------------------------------------------------------------
    -- Layout + initial visibility
    ------------------------------------------------------------------------

    applyLayout()

    local camera = workspace.CurrentCamera
    if camera then
        camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            applyLayout()
        end)
    end

    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        local newCamera = workspace.CurrentCamera
        if newCamera then
            applyLayout()
            newCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyLayout)
        end
    end)

    if visible then
        showWindow(false)
    else
        main.Visible = false
        main.GroupTransparency = 0
    end

    return window
end

return lib
