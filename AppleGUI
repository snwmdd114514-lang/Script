local function tween(instance, info, goal)
    local t = TweenService:Create(instance, info, goal)
    t:Play()
    return t
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = parent
    return c
end

local function circle(parent)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = parent
    return c
end

local function getGuiParent()
    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then
            return hui
        end
    end
    return CoreGui
end

local function safeProtect(gui)
    if syn and typeof(syn.protect_gui) == "function" then
        pcall(function()
            syn.protect_gui(gui)
        end)
    end
end

local function addPressAnimation(button, scaleAmount)
    scaleAmount = scaleAmount or 0.975

    local uiScale = Instance.new("UIScale")
    uiScale.Scale = 1
    uiScale.Parent = button

    local downTween
    local upTween

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if downTween then downTween:Cancel() end
            downTween = tween(
                uiScale,
                TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Scale = scaleAmount}
            )
        end
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if upTween then upTween:Cancel() end
            upTween = tween(
                uiScale,
                TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {Scale = 1}
            )
        end
    end)
end

local function createTrafficButton(parent, color, symbol, order)
    local hit = Instance.new("TextButton")
    hit.Name = symbol == "×" and "close" or (symbol == "−" and "minimize" or "resize")
    hit.Parent = parent
    hit.Size = UDim2.fromOffset(36, 44)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.LayoutOrder = order
    hit.ZIndex = 12

    local dot = Instance.new("Frame")
    dot.Name = "Dot"
    dot.Parent = hit
    dot.AnchorPoint = Vector2.new(0.5, 0.5)
    dot.Position = UDim2.fromScale(0.5, 0.5)
    dot.Size = UDim2.fromOffset(14, 14)
    dot.BackgroundColor3 = color
    dot.BorderSizePixel = 0
    dot.ZIndex = 13
    circle(dot)

    local glyph = Instance.new("TextLabel")
    glyph.Name = "Glyph"
    glyph.Parent = dot
    glyph.Size = UDim2.fromScale(1, 1)
    glyph.BackgroundTransparency = 1
    glyph.Text = symbol
    glyph.Font = Enum.Font.GothamBold
    glyph.TextSize = 10
    glyph.TextColor3 = Color3.fromRGB(80, 48, 40)
    glyph.TextTransparency = 1
    glyph.ZIndex = 14

    hit.MouseEnter:Connect(function()
        tween(glyph, TweenInfo.new(0.12), {TextTransparency = 0.15})
    end)
    hit.MouseLeave:Connect(function()
        tween(glyph, TweenInfo.new(0.12), {TextTransparency = 1})
    end)

    addPressAnimation(hit, 0.92)
    return hit
end

