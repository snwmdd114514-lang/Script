            label.TextSize = 16
            label.TextWrapped = true
            label.Text = labelName
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.ZIndex = 16
            return label
        end

        function sec:Switch(switchName, defaultmode, callback)
            local mode = defaultmode == true

            local row = Instance.new("Frame")
            row.Name = "toggleswitch"
            row.Parent = workareamain
            row.BackgroundTransparency = 1
            row.Size = UDim2.new(1, -8, 0, 46)
            row.ZIndex = 16

            local label = Instance.new("TextLabel")
            label.Parent = row
            label.BackgroundTransparency = 1
            label.Position = UDim2.fromOffset(0, 0)
            label.Size = UDim2.new(1, -86, 1, 0)
            label.Font = Enum.Font.Gotham
            label.Text = switchName
            label.TextColor3 = SECONDARY
            label.TextSize = 16
            label.TextWrapped = true
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.ZIndex = 17

            local hit = Instance.new("TextButton")
            hit.Name = "SwitchHit"
            hit.Parent = row
            hit.AnchorPoint = Vector2.new(1, 0.5)
            hit.Position = UDim2.new(1, 0, 0.5, 0)
            hit.Size = UDim2.fromOffset(76, 44)
            hit.BackgroundTransparency = 1
            hit.Text = ""
            hit.AutoButtonColor = false
            hit.ZIndex = 19

            local track = Instance.new("Frame")
            track.Name = "Track"
            track.Parent = hit
            track.AnchorPoint = Vector2.new(0.5, 0.5)
            track.Position = UDim2.fromScale(0.5, 0.5)
            track.Size = UDim2.fromOffset(54, 32)
            track.BackgroundColor3 = mode and BLUE or Color3.fromRGB(209, 209, 214)
            track.BorderSizePixel = 0
            track.ZIndex = 20
            circle(track)

            local knob = Instance.new("Frame")
            knob.Name = "Knob"
            knob.Parent = track
            knob.AnchorPoint = Vector2.new(0.5, 0.5)
            knob.Position = mode and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 16, 0.5, 0)
            knob.Size = UDim2.fromOffset(28, 28)
            knob.BackgroundColor3 = Color3.new(1, 1, 1)
            knob.BorderSizePixel = 0
            knob.ZIndex = 21
            circle(knob)

            -- One hit target only. The old nested TextButtons could both fire
            -- on touch and toggle twice, making the switch appear unresponsive.
            hit.Activated:Connect(function()
                mode = not mode
                tween(track, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = mode and BLUE or Color3.fromRGB(209, 209, 214)
                })
                tween(knob, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Position = mode and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 16, 0.5, 0)
                })
                if callback then callback(mode) end
            end)

            return row
        end

        function sec:TextField(fieldName, placeholder, callback)
            local row = Instance.new("Frame")
            row.Name = "textfield"
            row.Parent = workareamain
            row.BackgroundTransparency = 1
            row.Size = UDim2.new(1, -8, 0, currentMobile and 86 or 46)
            row.ZIndex = 16

            local label = Instance.new("TextLabel")
            label.Parent = row
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Gotham
            label.Text = fieldName
            label.TextColor3 = SECONDARY
            label.TextSize = 16
            label.TextWrapped = true
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.ZIndex = 17

            local field = Instance.new("Frame")
            field.Parent = row
            field.BackgroundColor3 = Color3.fromRGB(239, 239, 244)
            field.BorderSizePixel = 0
            field.ZIndex = 17
            corner(field, 10)

            if currentMobile then
                label.Position = UDim2.fromOffset(0, 0)
                label.Size = UDim2.new(1, 0, 0, 34)
                field.Position = UDim2.new(0, 0, 0, 40)
                field.Size = UDim2.new(1, 0, 0, 42)
            else
                label.Position = UDim2.fromOffset(0, 0)
                label.Size = UDim2.new(0.42, -8, 1, 0)
                field.Position = UDim2.new(0.42, 0, 0.5, -19)
                field.Size = UDim2.new(0.58, 0, 0, 38)
            end

            local textBox = Instance.new("TextBox")
            textBox.Parent = field
            textBox.BackgroundTransparency = 1
            textBox.Position = UDim2.fromOffset(12, 0)
            textBox.Size = UDim2.new(1, -24, 1, 0)
            textBox.ClearTextOnFocus = false
            textBox.Font = Enum.Font.Gotham
            textBox.PlaceholderColor3 = Color3.fromRGB(125, 125, 130)
            textBox.PlaceholderText = placeholder or "Type..."
            textBox.Text = ""
            textBox.TextColor3 = TEXT
            textBox.TextSize = 16
            textBox.TextXAlignment = Enum.TextXAlignment.Left
            textBox.ZIndex = 18

            if callback then
                textBox.FocusLost:Connect(function()
                    callback(textBox.Text)
                end)
            end
            return row
        end

        sidebar2.Activated:Connect(function()
            sec:Select()
        end)

        applyLayout()

        if #sections == 1 then
            sec:Select()
        end

        return sec
    end

    ------------------------------------------------------------------------
    -- Layout + initial visibility
    ------------------------------------------------------------------------

    applyLayout()

    local camera = workspace.CurrentCamera
    if camera then
        camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            applyLayout()
        end)
    end

    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        local newCamera = workspace.CurrentCamera
        if newCamera then
            applyLayout()
            newCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyLayout)
        end
    end)

    if visible then
        showWindow(false)
    else
        main.Visible = false
        main.GroupTransparency = 0
    end

    return window
end

return lib
