    local greenCallback = nil
    local maximized = false
    local restoreSize = nil
    local restorePosition = nil
    local restoreScale = nil

    local function toggleMaximize()
        if animating then return end
        local camera = workspace.CurrentCamera
        if not camera then return end

        if currentMobile then
            -- On phones the window is already presented near the safe bounds.
            -- Keep the control responsive without creating a strange second layout.
            task.spawn(playIslandJelly)
            return
        end

        if not maximized then
            restoreSize = main.Size
            restorePosition = main.Position
            restoreScale = mainScale.Scale
            maximized = true

            local v = camera.ViewportSize
            local targetW = math.max(760, v.X - 34)
            local targetH = math.max(520, v.Y - 76)

            tween(main, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(targetW, targetH),
                Position = UDim2.new(0.5, 0, 0.5, 0),
            })
            tween(mainScale, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Scale = 1})
        else
            maximized = false
            tween(main, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Size = restoreSize or UDim2.fromOffset(760, 520),
                Position = restorePosition or UDim2.new(0.5, 0, 0.5, 0),
            })
            tween(mainScale, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Scale = restoreScale or 1
            })
        end
    end

    resize.Activated:Connect(function()
        if greenCallback then
            greenCallback()
        else
            toggleMaximize()
        end
    end)

