    local function animateSectionButton(button, selected)
        tween(button, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = selected and 0 or 1,
            BackgroundColor3 = selected and BLUE or Color3.fromRGB(255, 255, 255),
            TextColor3 = selected and Color3.new(1, 1, 1) or TEXT,
        })
    end

    function window:Section(name)
        local sidebar2 = Instance.new("TextButton")
        sidebar2.Name = "sidebar2"
        sidebar2.Parent = sidebar
        sidebar2.BackgroundColor3 = BLUE
        sidebar2.BackgroundTransparency = 1
        sidebar2.Size = UDim2.new(1, -4, 0, 40)
        sidebar2.ZIndex = 13
        sidebar2.AutoButtonColor = false
        sidebar2.Font = Enum.Font.GothamMedium
        sidebar2.Text = name
        sidebar2.TextColor3 = TEXT
        sidebar2.TextSize = 17
        corner(sidebar2, 10)
        addPressAnimation(sidebar2, 0.975)
        table.insert(sidebarItems, sidebar2)

        local page = Instance.new("CanvasGroup")
        page.Name = "Page"
        page.Parent = workarea
        page.Size = UDim2.fromScale(1, 1)
        page.BackgroundTransparency = 1
        page.GroupTransparency = 1
        page.Visible = false
        page.ZIndex = 14

        local workareamain = Instance.new("ScrollingFrame")
        workareamain.Name = "workareamain"
        workareamain.Parent = page
        workareamain.Active = true
        workareamain.BackgroundTransparency = 1
        workareamain.BorderSizePixel = 0
        workareamain.Position = UDim2.fromOffset(12, 10)
        workareamain.Size = UDim2.new(1, -24, 1, -20)
        workareamain.AutomaticCanvasSize = Enum.AutomaticSize.Y
        workareamain.CanvasSize = UDim2.new(0, 0, 0, 0)
        workareamain.ScrollBarThickness = 2
        workareamain.ScrollBarImageColor3 = Color3.fromRGB(175, 175, 180)
        workareamain.ZIndex = 15

        local pageLayout = Instance.new("UIListLayout")
        pageLayout.Parent = workareamain
        pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Padding = UDim.new(0, 7)

        local item = {
            button = sidebar2,
            page = page,
            scroll = workareamain,
        }
        table.insert(sections, item)
        table.insert(workareas, page)

        local sec = {}

        function sec:Select()
            for index, info in ipairs(sections) do
                local selected = info == item
                animateSectionButton(info.button, selected)

                if selected then
                    if not info.page.Visible then
                        info.page.Visible = true
                        info.page.GroupTransparency = 1
                        info.page.Position = UDim2.fromOffset(8, 0)
                        tween(info.page, TweenInfo.new(0.20, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                            GroupTransparency = 0,
                            Position = UDim2.fromOffset(0, 0),
                        })
                    end
                    selectedIndex = index
                else
                    info.page.Visible = false
                    info.page.GroupTransparency = 1
                end
            end
        end

        function sec:Divider(dividerName)
            local section = Instance.new("TextLabel")
            section.Name = "section"
            section.Parent = workareamain
            section.BackgroundTransparency = 1
            section.Size = UDim2.new(1, -8, 0, 42)
            section.Font = Enum.Font.GothamMedium
            section.Text = dividerName
            section.TextColor3 = TEXT
            section.TextSize = 20
            section.TextWrapped = true
            section.TextXAlignment = Enum.TextXAlignment.Left
            section.TextYAlignment = Enum.TextYAlignment.Bottom
            section.ZIndex = 16
        end

        function sec:Button(buttonName, callback)
            local button = Instance.new("TextButton")
            button.Name = "button"
            button.Text = buttonName
            button.Parent = workareamain
            button.BackgroundColor3 = Color3.fromRGB(239, 239, 244)
            button.BackgroundTransparency = 0.1
            button.Size = UDim2.new(1, -8, 0, 44)
            button.ZIndex = 16
            button.Font = Enum.Font.GothamMedium
            button.TextColor3 = BLUE
            button.TextSize = 17
            button.AutoButtonColor = false
            corner(button, 11)

            local stroke = Instance.new("UIStroke")
            stroke.Parent = button
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Color = Color3.fromRGB(215, 215, 220)
            stroke.Transparency = 0.35
            stroke.Thickness = 1

            addPressAnimation(button, 0.975)

            if callback then
                button.Activated:Connect(function()
                    callback()
                end)
            end
            return button
        end

        function sec:Label(labelName)
            local label = Instance.new("TextLabel")
            label.Name = "label"
